#!/usr/bin/env bash
# Stop the VM: ask QEMU to quit, then clean up its virtiofsd helpers.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

if ! vm_running; then
  echo "VM is not running"
  rm -f "$PID_FILE" "$QMP_SOCK"
  exit 0
fi

pid=$(cat "$PID_FILE")
qmp quit 2>/dev/null || kill "$pid" 2>/dev/null || true
for _ in $(seq 1 50); do
  kill -0 "$pid" 2>/dev/null || break
  sleep 0.2
done
kill -9 "$pid" 2>/dev/null || true
# vm/up started the run script with setsid, so its pid is the process group.
kill -- "-$pid" 2>/dev/null || true
rm -f "$PID_FILE" "$QMP_SOCK"
echo "VM stopped"
